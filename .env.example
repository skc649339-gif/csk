# 第一阶段不需要任何 API key。根域本地预览无需创建 .env.local。
# GitHub Pages 项目站点设置 /仓库名；用户名.github.io 或自定义域名留空。
NEXT_PUBLIC_BASE_PATH=
NEXT_TELEMETRY_DISABLED=1

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：开源版不含 /api/interpret 等后端接口，下面这组配置只在你自己实现了接口后才会用到；
# 只想排盘、看命盘的话不用填。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
